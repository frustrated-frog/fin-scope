FINSCOPE_MARKET_DATA_DATA_DIR=./data
FINSCOPE_MARKET_DATA_MAX_RETRIES=1
FINSCOPE_MARKET_DATA_RETRY_DELAY_SECONDS=0.2
FINSCOPE_MARKET_DATA_FAILURE_THRESHOLD=3
FINSCOPE_MARKET_DATA_CIRCUIT_OPEN_SECONDS=60

# 同花顺结构化金融数据：A 股日 K、财报和行业成分的唯一在线来源。
